{
  "name": "starlight-page-context-action",
  "version": "0.0.0-semantically-released",
  "description": "A Starlight plugin that adds page action buttons to the right sidebar above the table of contents.",
  "type": "module",
  "author": "babblebey",
  "repository": {
    "type": "git",
    "url": "https://github.com/babblebey/starlight-page-context-action"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/babblebey/starlight-page-context-action#readme",
  "bugs": "https://github.com/babblebey/starlight-page-context-action/issues",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./overrides/PageSidebar.astro": "./overrides/PageSidebar.astro",
    "./overrides/MobileTableOfContents.astro": "./overrides/MobileTableOfContents.astro"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "virtual.d.ts",
    "overrides",
    "components"
  ],
  "keywords": [
    "starlight",
    "astro",
    "plugin",
    "page-context-action",
    "clipboard",
    "ai"
  ],
  "dependencies": {
    "vite-plugin-static-copy": "^3.0.0",
    "vite-plugin-virtual": "^0.3.0"
  },
  "peerDependencies": {
    "@astrojs/starlight": ">=0.36.0",
    "astro": ">=5.0.0"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.41.4",
    "astro": "^7.1.3"
  },
  "release": {
    "plugins": [
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "successComment": ":tada: This PR is included in **${nextRelease.gitTag}** :tada:\n\nThe release is available on [GitHub release](${releases?.[0]?.url || ''})\n\nYour **[semantic-release](https://github.com/semantic-release/semantic-release)** bot :package::rocket:"
        }
      ]
    ]
  }
}
