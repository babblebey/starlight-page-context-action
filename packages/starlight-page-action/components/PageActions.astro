  }

  .page-actions--spread .page-action-label {
    flex: 1;
  }

  .page-actions--spread .page-action-chevron {
    flex-shrink: 0;
    margin-inline-start: auto;
  }

  .page-actions--spread .page-action-dropdown-wrapper {
    position: relative;
  }

  /* ===== Compact layout ===== */
  .page-actions--compact {
