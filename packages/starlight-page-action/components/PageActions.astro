    position: fixed;
    display: flex;
    flex-direction: column;
    min-width: 12rem;
    padding: 0.375rem;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    z-index: 10;
  }

  .page-action-popup-item {
    display: flex;
