    border-radius: 0.25rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-xs);
    cursor: pointer;
    text-align: start;
    line-height: 1.5;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .page-actions--spread .page-action-btn:hover {
